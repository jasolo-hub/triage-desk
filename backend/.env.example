# Copy to .env and adjust. Values below match docker-compose.yml at the repo root.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
# Optional: direct (non-pooled) URL for `prisma migrate` — required when DATABASE_URL
# goes through a pooler (Neon -pooler / PgBouncer), which cannot hold advisory locks.
# DATABASE_URL_DIRECT=postgresql://user:pass@host-without-pooler/db?sslmode=verify-full
# Optional: max DB connections per API instance (default 10)
# DB_POOL_MAX=10

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# S3-compatible storage (S3Mock locally, Backblaze B2 in production — any S3 API works)
S3_ENDPOINT=http://localhost:9090
S3_REGION=auto
S3_BUCKET=triage-attachments
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true

# Optional AI assistant (any OpenAI-compatible endpoint; Groq free tier by default).
# Leave AI_API_KEY empty and /api/ai/ask answers 503 while the app keeps working.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b

# Password for all seeded users (default Password123! if unset)
SEED_PASSWORD=Password123!

REOPEN_WINDOW_DAYS=7
