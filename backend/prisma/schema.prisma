// Prisma 7: the connection URL lives in prisma.config.ts, the runtime client
// connects through the pg driver adapter (see src/prisma/prisma.service.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Nest 12 scaffolds an ES-module project (D17), so the client is ESM too.
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Length limits (@db.VarChar) repeat the DTO limits so the database enforces
// them for every writer (seed, scripts, psql), not only the API (D29). Long free
// text (ticket description, comment body) stays TEXT: its cap is a product rule
// that lives in the DTO.
model User {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique @db.VarChar(320) // 64 local part + "@" + 255 domain
  name                     String    @db.VarChar(200)
  role                     Role      @default(AGENT)
  passwordHash             String
  // One active session per user (D3): SHA-256 of the current refresh token.
  refreshTokenHash         String?
  refreshTokenExpiresAt    DateTime?
  // Hash of the token that was rotated away last. Only presenting exactly this
  // one counts as replay and revokes the session; any other mismatch is just an
  // invalid token, so garbage cannot log a user out (D27).
  previousRefreshTokenHash String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  assignedTickets Ticket[]
  comments        Comment[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  email     String   @unique @db.VarChar(320)
  company   String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(200)
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  customerId  Int
  // Restrict: a customer with tickets cannot be deleted (409), history is kept.
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assigneeId  Int?
  // SetNull: deleting an agent un-assigns their tickets instead of deleting them.
  assignee    User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tags     Tag[]
  comments Comment[]

  @@index([status])
  // Serves the isOverdue filter: (priority = X AND createdAt < now - SLA(X)).
  @@index([priority, createdAt])
  @@index([createdAt])
  @@index([assigneeId])
  @@index([customerId])
}

model Comment {
  id                    Int      @id @default(autoincrement())
  ticketId              Int
  ticket                Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId              Int
  // Restrict: an author with comments cannot be deleted, ticket history stays intact.
  author                User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body                  String
  isResolution          Boolean  @default(false)
  // Optional attachment (object storage). Unique key = one object per comment.
  attachmentKey         String?  @unique
  // Name capped at upload (upload-rules.ts); content type comes from the allowlist.
  attachmentName        String?  @db.VarChar(255)
  attachmentContentType String?  @db.VarChar(100)
  attachmentSize        Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  color String @db.VarChar(7) // "#rrggbb"

  // Implicit many-to-many: Prisma manages the join table (_TagToTicket).
  tickets Ticket[]
}
